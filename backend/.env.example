# ============================================================
# Razorpay
# ============================================================
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ============================================================
# LLM (pick one — add real key to .env, NOT here)
# ============================================================
GOOGLE_API_KEY=AIzaSy_your_gemini_key_here
# OPENAI_API_KEY=sk-your_openai_key_here
# GROQ_API_KEY=gsk_your_groq_key_here

# ============================================================
# Database (local SQLite — no setup needed)
# ============================================================
DATABASE_URL=sqlite:///./data/autodefend.db

# ============================================================
# Redis (task queue for parallel executors)
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# App behaviour
# ============================================================
APP_ENV=development
LOG_LEVEL=INFO
AUTO_DEFEND_CONFIDENCE_THRESHOLD=0.70
HIGH_VALUE_THRESHOLD_PAISE=500000
AUTONOMOUS_MAX_PAISE=500000
USE_MOCK_APIS=true
