# ============================================================
# Razorpay
# ============================================================
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ============================================================
# LLM (pick one)
# ============================================================
GOOGLE_API_KEY=AIzaSy_your_gemini_key_here
# OPENAI_API_KEY=sk-your_openai_key_here

# ============================================================
# Database (PostgreSQL)
# ============================================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/autodefenddb

# ============================================================
# Redis (task queue for parallel executors)
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# App behaviour
# ============================================================
APP_ENV=development
LOG_LEVEL=INFO

# Confidence threshold for auto-filing (0.0 - 1.0)
# Below this -> system recommends ACCEPT instead of filing
AUTO_DEFEND_CONFIDENCE_THRESHOLD=0.70

# Disputes above this amount (paise) require explicit merchant approval
# 500000 paise = Rs.5,000
HIGH_VALUE_THRESHOLD_PAISE=500000

# Max Rs. threshold for full autonomous filing (no notification window)
# 500000 paise = Rs.5,000 -> below this = fully autonomous
AUTONOMOUS_MAX_PAISE=500000

# Use mock data sources instead of real external APIs (set True for demo)
USE_MOCK_APIS=true
